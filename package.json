  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "corpus:build": "node scripts/build-regulatory-corpus.mjs",
    "corpus:embed": "node scripts/embed-regulatory-corpus.mjs",
