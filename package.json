    "corpus:monitor": "node scripts/monitor-regulatory-sources.mjs",
    "eval:answers": "node scripts/evaluate-assistant-answers.mjs",
    "rag:test": "node --experimental-strip-types --test src/lib/rag/retrieval.test.ts",
    "tools:test": "node --experimental-strip-types --test src/lib/tools/calculators.test.ts",
    "rag:evaluate": "node --experimental-strip-types scripts/evaluate-regulatory-retrieval.mjs",
    "billing:test": "node --experimental-strip-types --test src/lib/billing/entitlements.test.ts",
    "connectors:test": "node --experimental-strip-types --test src/lib/connectors/truth.test.ts",
    "trials:test": "node --experimental-strip-types --test src/lib/trials/domain.test.ts",
