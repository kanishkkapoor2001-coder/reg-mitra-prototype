    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
