{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/cron/calendar-refresh",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/rule-import",
      "schedule": "0 4 * * 1,3,5"
    }
  ]
}
