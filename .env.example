# query + corpus embeddings use the direct Google API. Leave blank for lexical-only.
GOOGLE_GENERATIVE_AI_API_KEY=
REGMITRA_EMBEDDING_MODEL=gemini-embedding-2
REGMITRA_ENABLE_LIVE_AI=false
CRON_SECRET=
APP_URL=https://reg-mitra-migration.vercel.app
