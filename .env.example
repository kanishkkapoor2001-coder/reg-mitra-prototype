# Chat + streaming run through the AI Gateway (Vertex-proxied Gemini).
REGMITRA_AI_GATEWAY_URL=https://ssi-platform-2bvui.ondigitalocean.app/ai-gateway
REGMITRA_AI_GATEWAY_KEY=
REGMITRA_VERTEX_PROJECT=windy-forge-459612-s2
REGMITRA_VERTEX_LOCATION=global
REGMITRA_LLM_MODEL=gemini-2.5-flash
